{
  "name": "clerk-tanstack-react-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "tokens": "bezel build",
    "postinstall": "bezel build",
    "dev": "bun run tokens && bun scripts/dev.ts",
    "build": "bun run tokens && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test:e2e",
    "check:ci": "bun run lint && bun run typecheck",
    "deploy": "vercel --prod",
    "lint": "oxlint",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "demo:setup": "bun scripts/setup-demo-user.ts"
  },
  "dependencies": {
