# Copy to .env.local and fill in values.
# Local default is Plaid sandbox. Use `bun run dev -- --production` only for real bank data.

# --- Auth (Clerk) ---
# Browser needs the VITE_ prefix; server uses CLERK_SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_SIGN_IN_URL=/sign-in
# Opt-in only: skip Clerk and use a fixed local user (e2e / agent). Never set on demos.
# MONAI_DEV_AUTH_BYPASS=1

# --- Database ---
# Local SQLite (default sandbox):
DATABASE_URL=file:./data/dev.db
# Optional dedicated sandbox path (used by `bun run dev` without --production):
# PLAID_SANDBOX_DATABASE_URL=file:./data/dev.db

# Real-data local DB (only with `bun run dev -- --production`):
# PLAID_PRODUCTION_DATABASE_URL=file:./data/production.db

# Turso (required for Vercel demo — never point this at production.db contents):
# TURSO_DATABASE_URL=libsql://monai-demo-xxxx.turso.io
# TURSO_AUTH_TOKEN=...

# --- Plaid ---
PLAID_CLIENT_ID=
# Default / sandbox mode (`bun run dev`):
PLAID_ENV=sandbox
PLAID_SECRET=
# Optional aliases used by scripts/dev.ts:
# PLAID_SANDBOX_ENV=sandbox
# PLAID_SANDBOX_SECRET=

# Production Plaid (ONLY for local `bun run dev -- --production` — never on public Vercel):
# PLAID_PRODUCTION_ENV=production
# PLAID_PRODUCTION_SECRET=

# --- AI categorization ---
# Primary path: Vercel AI Gateway (works locally and on Vercel). Get a key from
# the Vercel dashboard → AI Gateway → API Keys, and set the same value on Vercel.
AI_GATEWAY_API_KEY=
# Optional overrides (defaults shown):
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_MODEL=openai/gpt-5.1
# AI_GATEWAY_TIMEOUT_MS=90000

# Fallback: local `pi` CLI (only used when the Gateway call fails and we're
# running on your machine, or when MONAI_SERVER_AI=pi-cli is set). It reuses
# your pi provider/model setup but runs in an isolated agent dir with Monai's
# system prompt, no tools, and thinking pinned to minimal.
# MONAI_SERVER_AI=pi-cli
# PI_CLI_PATH=pi
# PI_CATEGORIZER_MODEL=vmc/cheap-flash
# PI_CATEGORIZER_THINKING=minimal
# PI_CATEGORIZER_TIMEOUT_MS=90000
