# Copy to .env.local and fill in values.
# Local default is Plaid sandbox. Use `bun run dev -- --production` only for real bank data.

# --- Auth (Clerk) ---
# Browser needs the VITE_ prefix; server uses CLERK_SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_SIGN_IN_URL=/sign-in
# Opt-in only: skip Clerk and use a fixed local user (e2e / agent). Never set on demos.
# MONAI_DEV_AUTH_BYPASS=1

# --- Database ---
# Local SQLite (default sandbox):
DATABASE_URL=file:./data/dev.db
# Optional dedicated sandbox path (used by `bun run dev` without --production):
# PLAID_SANDBOX_DATABASE_URL=file:./data/dev.db

# Real-data local DB (only with `bun run dev -- --production`):
# PLAID_PRODUCTION_DATABASE_URL=file:./data/production.db

# Turso (required for Vercel demo — never point this at production.db contents):
# TURSO_DATABASE_URL=libsql://monai-demo-xxxx.turso.io
# TURSO_AUTH_TOKEN=...

# --- Plaid ---
PLAID_CLIENT_ID=
# Default / sandbox mode (`bun run dev`):
PLAID_ENV=sandbox
PLAID_SECRET=
# Optional aliases used by scripts/dev.ts:
# PLAID_SANDBOX_ENV=sandbox
# PLAID_SANDBOX_SECRET=

# Production Plaid (ONLY for local `bun run dev -- --production` — never on public Vercel):
# PLAID_PRODUCTION_ENV=production
# PLAID_PRODUCTION_SECRET=

# --- AI categorization (Vercel AI Gateway, server-only) ---
# Local / CI: create a key at the Vercel project → AI Gateway → API keys.
# Never prefix this with VITE_ — it must not reach the browser.
AI_GATEWAY_API_KEY=
# Optional model override. Default in code: deepseek/deepseek-v4.1-flash
# AI_CATEGORIZE_MODEL=deepseek/deepseek-v4.1-flash
# On Vercel deployments, enable AI Gateway on the project so VERCEL_OIDC_TOKEN is
# injected. No API key is required in production when OIDC is enabled.
# Sync still applies rules only. Manual AI Categorize uses the gateway.
# Legacy Cursor CLI vars are unused:
# CURSOR_API_KEY=
# CURSOR_CLI_PATH=agent
# CURSOR_CATEGORIZER_MODEL=
